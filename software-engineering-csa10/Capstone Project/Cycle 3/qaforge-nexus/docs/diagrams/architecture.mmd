  API --> LIFE
  ENG -->|"black-box HTTP requests"| SUT
  ENG -->|"black-box HTTP requests"| EXT
  ENG -->|"failed result"| LIFE
  API --> DB
  ENG --> DB
  LIFE --> DB
  DS -->|"seed import"| DB
